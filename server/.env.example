# ==========================================
# SFIDABOT BACKEND SERVER CONFIGURATION
# ==========================================

PORT=3000
HOST=0.0.0.0

# Telegram Bot Token (da @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# URL della Mini-App frontend
WEBAPP_URL=https://sfida-bot.vercel.app

# TON Blockchain RPC
# TESTNET:
TON_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
# MAINNET:
# TON_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC

TON_API_KEY=

# Chiave segreta (32 byte hex = 64 caratteri) per la firma Ed25519 delle partite
# Generare con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SIGNER_SEED=

# Indirizzo dello smart contract Factory (ottenuto dopo npm run deploy:contracts)
CLASH_MASTER_ADDRESS=

# Indirizzo del wallet TON dell'admin (ricezione proventi)
OWNER_ADDRESS=

# Bot Cassa Wallet Mnemonic (24 parole per i prelievi on-chain istantanei agli utenti)
# Creare un wallet TON dedicato (es. su Tonkeeper W5 o V4) e incollare le 24 parole separate da spazio:
SERVER_HOT_WALLET_MNEMONIC=

# Indirizzo pubblico del Bot Cassa Wallet (opzionale, se omesso viene derivato automaticamente dal mnemonic)
# BOT_CASSA_WALLET_ADDRESS=

