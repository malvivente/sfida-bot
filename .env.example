# ==========================================
# SFIDABOT - CONFIGURAZIONE SERVER & AMBIENTE
# ==========================================

# 1. Porta e Host del server backend Fastify & WebSocket
PORT=3000
HOST=0.0.0.0

# 2. Telegram Bot Token (ottenuto da @BotFather su Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 3. URL pubblico della Mini-App (Vercel)
WEBAPP_URL=https://sfida-bot.vercel.app

# 4. TON Blockchain RPC Endpoint
# TESTNET (per test gratuiti):
TON_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
# MAINNET (per produzione reale):
# TON_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC

# 5. TON API Key (opzionale su Testnet, consigliata per Mainnet da https://tonconsole.com o @tonapibot)
TON_API_KEY=

# 6. Seed Ed25519 del Server Signer (32 byte = 64 caratteri hex)
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SIGNER_SEED=

# 7. Indirizzo dello Smart Contract ClashMaster distribuito su TON
# Lo ottieni eseguendo: npm run deploy:contracts
CLASH_MASTER_ADDRESS=

# 8. Indirizzo del tuo Wallet TON personale (riceve le commissioni / treasury rake)
OWNER_ADDRESS=

# 9. Bot Cassa Wallet Mnemonic (24 parole per i prelievi on-chain istantanei agli utenti)
# Creare un wallet TON dedicato (es. su Tonkeeper W5 o V4) e incollare le 24 parole separate da spazio:
SERVER_HOT_WALLET_MNEMONIC=

# 10. Indirizzo pubblico del Bot Cassa Wallet (opzionale, se omesso viene derivato automaticamente dal mnemonic)
# BOT_CASSA_WALLET_ADDRESS=

