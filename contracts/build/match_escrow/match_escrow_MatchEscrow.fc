int $global_calculatePlayerRake(int $totalPot) impure inline_ref {
    return (($totalPot * 4) / 100);
}

int $global_calculateSpectatorRake(int $totalSpectatorPool) impure inline_ref {
    return (($totalSpectatorPool * 6) / 100);
}

int $global_calculateSpectatorShare(int $betAmount, int $distributablePool, int $totalWinningBets) impure inline_ref {
    ifnot ($totalWinningBets) {
        return 0;
    }
    return (($betAmount * $distributablePool) / $totalWinningBets);
}

(int, int, int) $global_splitRake(int $totalRake, int $hasRecruiter, int $hasGroupAdmin) impure inline_ref {
    int $treasuryBaseline = (($totalRake * 70) / 100);
    int $affiliatePool = ($totalRake - $treasuryBaseline);
    if (( ($hasRecruiter) ? ($hasGroupAdmin) : (false) )) {
        int $recruiterHalf = ($affiliatePool / 2);
        int $groupAdminHalf = ($affiliatePool - $recruiterHalf);
        return $RakeDistribution$_constructor_treasuryShare_recruiterShare_groupAdminShare($treasuryBaseline, $recruiterHalf, $groupAdminHalf);
    }
    if ($hasRecruiter) {
        return $RakeDistribution$_constructor_treasuryShare_recruiterShare_groupAdminShare($treasuryBaseline, $affiliatePool, 0);
    }
    if ($hasGroupAdmin) {
        return $RakeDistribution$_constructor_treasuryShare_recruiterShare_groupAdminShare($treasuryBaseline, 0, $affiliatePool);
    }
    return $RakeDistribution$_constructor_treasuryShare_recruiterShare_groupAdminShare($totalRake, 0, 0);
}

